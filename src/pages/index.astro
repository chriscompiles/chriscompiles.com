---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects } from '../data/projects';
import { elsewhere } from '../data/elsewhere';

const title = 'Chris Compiles — Building, shipping & creating';
const description = 'A home for things I’m building, shipping and creating. Software, experiments, writing and other things I decided to make.';
---

<SiteLayout title={title} description={description} canonicalPath="/">
      <main id="main" tabindex="-1">
        <section class="hero" aria-labelledby="intro-title">
          <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> An ongoing collection</p>
          <h1 id="intro-title">A home for things<br class="desktop-break" /> I’m <span class="accent">building, shipping</span><br class="desktop-break" /> and creating.</h1>
          <p class="intro">Software, experiments, writing and other things<br class="desktop-break" /> I decided to make.</p>
        </section>

        <section id="projects" class="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <h2 id="projects-title">The projects</h2>
              <p>Different things. Same pair of hands.</p>
            </div>
            <span class="project-count" aria-label={`${projects.length} projects`}>[{String(projects.length).padStart(2, '0')}]</span>
          </div>
          <ol class="project-list">
            {projects.map((project, index) => {
              const Tag = project.url ? 'a' : 'div';
              return (
                <li>
                  <Tag class:list={['project-row', { 'project-linked': project.url }]} href={project.url}>
                    <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <div class="project-copy">
                      <h3>{project.name}{project.url && <span class="project-arrow" aria-hidden="true">↗</span>}</h3>
                      <p>{project.description}</p>
                    </div>
                    <span class:list={['status', `status-${project.status.toLowerCase()}`]}>
                      <span class="status-dot" aria-hidden="true"></span>{project.status}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ol>
          <p class="project-footnote">Some things are live. Others are still finding their shape.</p>
        </section>

        <div class="about-elsewhere">
          <section id="about" class="about" aria-labelledby="about-title">
            <h2 id="about-title">A little context</h2>
            <p>I’m Chris. I work in risk and learning. Outside work, I build software, experiment with AI and write.</p>
            <p>There isn’t a grand plan connecting all of this. I like making things, and this is where they live.</p>
          </section>
          <section class="elsewhere" aria-labelledby="elsewhere-title">
            <h2 id="elsewhere-title">Elsewhere</h2>
            <ul>
              {elsewhere.map((profile) => (
                <li>
                  <a href={profile.url} rel="me">{profile.name}<span aria-hidden="true">↗</span></a>
                  <p>{profile.label}</p>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </main>
</SiteLayout>
