---
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { projects } from '../data/projects';
import { elsewhere } from '../data/elsewhere';
import '../styles/global.css';

const title = 'Chris Compiles — Building, shipping & creating';
const description = 'A home for things I’m building, shipping and creating. Software, experiments, writing and other things I decided to make.';
const canonical = new URL('/', Astro.site);
const socialImage = new URL('/social.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191d1a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Chris Compiles" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="chriscompiles.com — A home for things I’m building, shipping and creating." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="chriscompiles.com — A home for things I’m building, shipping and creating." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="chriscompiles.com home">
          <svg class="brand-mark" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M11 5H5v18h6M17 5h6v18h-6" stroke="currentColor" stroke-width="2" />
            <path d="M12 12h4v4h-4z" fill="currentColor" />
          </svg>
          <span>chriscompiles<span class="domain">.com</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <main id="main" tabindex="-1">
        <section class="hero" aria-labelledby="intro-title">
          <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> An ongoing collection</p>
          <h1 id="intro-title">A home for things<br class="desktop-break" /> I’m <span class="accent">building, shipping</span><br class="desktop-break" /> and creating.</h1>
          <p class="intro">Software, experiments, writing and other things<br class="desktop-break" /> I decided to make.</p>
        </section>

        <section id="projects" class="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <h2 id="projects-title">The projects</h2>
              <p>Different things. Same pair of hands.</p>
            </div>
            <span class="project-count" aria-label={`${projects.length} projects`}>[{String(projects.length).padStart(2, '0')}]</span>
          </div>
          <ol class="project-list">
            {projects.map((project, index) => {
              const Tag = project.url ? 'a' : 'div';
              return (
                <li>
                  <Tag class:list={['project-row', { 'project-linked': project.url }]} href={project.url}>
                    <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <div class="project-copy">
                      <h3>{project.name}{project.url && <span class="project-arrow" aria-hidden="true">↗</span>}</h3>
                      <p>{project.description}</p>
                    </div>
                    <span class:list={['status', `status-${project.status.toLowerCase()}`]}>
                      <span class="status-dot" aria-hidden="true"></span>{project.status}
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ol>
          <p class="project-footnote">Some things are live. Others are still finding their shape.</p>
        </section>

        <div class="about-elsewhere">
          <section id="about" class="about" aria-labelledby="about-title">
            <h2 id="about-title">A little context</h2>
            <p>I’m Chris. I work in risk and learning. Outside work, I build software, experiment with AI and write.</p>
            <p>There isn’t a grand plan connecting all of this. I like making things, and this is where they live.</p>
          </section>
          <section class="elsewhere" aria-labelledby="elsewhere-title">
            <h2 id="elsewhere-title">Elsewhere</h2>
            <ul>
              {elsewhere.map((profile) => (
                <li>
                  <a href={profile.url} rel="me">{profile.name}<span aria-hidden="true">↗</span></a>
                  <p>{profile.label}</p>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Chris <span class="footer-separator" aria-hidden="true">/</span> Made at my own pace.</p>
        <span class="version">v0.1 <span aria-hidden="true">·</span> Still compiling</span>
      </footer>
    </div>
  </body>
</html>
