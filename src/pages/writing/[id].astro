---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('writing', ({ data }) => !data.draft);

  return pieces.map((piece) => ({
    params: { id: piece.id },
    props: { piece },
  }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
const { title, description, publicationDate, type } = piece.data;
const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(publicationDate);
---

<SiteLayout
  title={`${title} — Chris Compiles`}
  description={description}
  canonicalPath={`/writing/${piece.id}/`}
  type="article"
  publishedTime={publicationDate}
>
  <main id="main" class="article-page" tabindex="-1">
    <a class="writing-back" href="/writing/"><span aria-hidden="true">←</span> All writing</a>
    <article>
      <header class="article-header">
        <div class="article-meta">
          <span>{type}</span>
          <time datetime={publicationDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </main>
</SiteLayout>
